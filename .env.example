# -----------------------------------------------------------------------------
# American Signal Desk — environment template
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development:  cp .env.example .env.local
#
# NEVER commit a filled-in .env file. In production, set these in your hosting
# provider's encrypted environment settings — not in source control, and not in chat.
#
# Variables left blank simply disable their feature. Every such feature renders an
# explicit "not configured" state rather than pretending to work.
# -----------------------------------------------------------------------------

# --- Public (safe to expose to the browser) -----------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="American Signal Desk"

# --- Supabase (required for content, auth, admin) -----------------------------
# Project settings → API. The anon key is public by design and protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS — never expose, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct/pooled Postgres connection, used only by the migration and DB-test scripts.
DATABASE_URL=

# --- Redis / background workers -----------------------------------------------
# Required by the BullMQ worker. Not required by the web app.
REDIS_URL=

# --- Security policy ----------------------------------------------------------
# Require a verified second factor for admin access. Leave unset to require MFA (default).
REQUIRE_MFA_FOR_ADMIN=true

# --- Optional integrations (blank = feature disabled, never faked) ------------
AI_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
DEPLOYMENT_PROVIDER_TOKEN=
# --- Email -------------------------------------------------------------------
# Newsletter confirmation is recorded in an outbox table and sent by the worker.
# With neither variable set, messages stay queued and the worker reports "not configured"
# rather than pretending to send. EMAIL_FROM must be an address on a domain you control.
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret for scheduled endpoints (min 16 chars).
CRON_SECRET=

# --- Local development only ---------------------------------------------------
# Comma-separated hosts allowed to load dev resources (HMR) when the dev server is
# accessed through a proxy/tunnel, e.g. "3000-abc123.e2b.app". Leave unset in production.
ALLOWED_DEV_ORIGINS=
